{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": "vite",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://ayudhvikasfoundation.onrender.com/api/:path*"
    },
    {
      "source": "/src/assets/:path*",
      "destination": "https://ayudhvikasfoundation.onrender.com/src/assets/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
